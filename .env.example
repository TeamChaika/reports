# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter (AI-аналитика)
OPENROUTER_API_KEY=your-openrouter-key
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# iiko API Server
IIKO_BASE_URL=http://your-iiko-server:9900
IIKO_LOGIN=your-login
# Пароль хранится в Supabase Vault, здесь только для первичной настройки
# IIKO_PASSWORD_MD5=md5-hash-of-password

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_BOT_SECRET=your-webhook-secret

# Vercel Cron (защита эндпоинтов)
CRON_SECRET=your-cron-secret
